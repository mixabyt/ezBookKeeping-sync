GIN_MODE=debug
LOG_LEVEL=debug

# Лише для ручної реєстрації вебхука (POST https://api.monobank.ua/personal/webhook).
# Для перевірки підпису вебхука не потрібен: ключ банку публічний (/bank/sync).
MONOBANK_API_KEY=

# без "/" у кінці
EZ_BOOK_KEEPING_BASE_URL=
EZ_BOOK_KEEPING_KEY=

DB_CONNECTION=sqlite
# для SQLite — шлях до файлу відносно робочого каталогу
DB_DATABASE=database/ezBookKeepingTool

BIND_ADDR=':8089'

# Авторизація PWA (хеш: go run ./cmd/hashpw, секрет: openssl rand -hex 32)
# AUTH_PASSWORD_HASH обовʼязково в одинарних лапках: godotenv розгортає $... у
# незакавичених значеннях, а bcrypt-хеш починається з $2a$10$ і приїде покаліченим.
AUTH_LOGIN=
AUTH_PASSWORD_HASH=''
AUTH_SECRET=
