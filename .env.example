GIN_MODE=debug
LOG_LEVEL=debug

# Публічна адреса вебхука без токена, без "/" у кінці, напр. https://example.com/mono-webhook
# Потрібна, щоб реєструвати вебхук із налаштувань PWA.
MONO_WEBHOOK_BASE_URL=

# Лише для ручної реєстрації вебхука (POST https://api.monobank.ua/personal/webhook).
# Для перевірки підпису вебхука не потрібен: ключ банку публічний (/bank/sync).
MONOBANK_API_KEY=

# Черга вебхуків на VPS (лише через VPN), напр. http://10.0.0.1:8095/pending/
# Порожньо — сервіс чергу не забирає.
MONO_SPOOL_URL=

# без "/" у кінці
EZ_BOOK_KEEPING_BASE_URL=
# Лише для першого старту: токен власника. Далі токени живуть у БД і змінюються в PWA.
EZ_BOOK_KEEPING_KEY=

# шлях до файлу SQLite відносно робочого каталогу
DB_DATABASE=database/ezBookKeepingTool

BIND_ADDR=':8089'

# Авторизація PWA (хеш: go run ./cmd/hashpw, секрет: openssl rand -hex 32)
# AUTH_LOGIN і AUTH_PASSWORD_HASH потрібні лише при першому старті: вони заповнюють
# рядок власника в БД, далі пароль змінюється в PWA. AUTH_SECRET потрібен завжди.
# AUTH_PASSWORD_HASH обовʼязково в одинарних лапках: godotenv розгортає $... у
# незакавичених значеннях, а bcrypt-хеш починається з $2a$10$ і приїде покаліченим.
AUTH_LOGIN=
AUTH_PASSWORD_HASH=''
AUTH_SECRET=
